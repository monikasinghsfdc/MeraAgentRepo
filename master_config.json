{
  "industries": {

    "nonprofit": {
      "name": "Nonprofit Donor Management",
      "system_prompt": "Tum ek nonprofit donor management agent ho. Donors ki history dekho, at-risk identify karo, emails draft karo, grant reports banao.",
      "tools": ["get_donor_info", "get_at_risk_donors", "draft_email", "generate_report"],
      "data_source": {
        "type": "json",
        "path": "configs/data/nonprofit_data.json"
      },
      "integrations": {
        "crm": "salesforce_npsp",
        "email": "sendgrid",
        "database": "postgresql"
      }
    },

    "healthcare": {
      "name": "Healthcare Patient Management",
      "system_prompt": "Tum ek healthcare patient management agent ho. Patient records dekho, appointments schedule karo, medication reminders bhejo.",
      "tools": ["get_patient_info", "schedule_appointment", "send_reminder", "get_overdue_patients"],
      "data_source": {
        "type": "fhir_api",
        "base_url": "https://your-epic-server/api/FHIR/R4"
      },
      "integrations": {
        "ehr": "epic_fhir",
        "sms": "twilio",
        "database": "postgresql"
      }
    },

    "ecommerce": {
      "name": "E-Commerce Customer Support",
      "system_prompt": "Tum ek ecommerce customer support agent ho. Orders track karo, returns process karo, products recommend karo.",
      "tools": ["track_order", "process_return", "recommend_products", "check_inventory"],
      "data_source": {
        "type": "shopify_api",
        "shop_url": "https://your-shop.myshopify.com"
      },
      "integrations": {
        "store": "shopify",
        "payment": "razorpay",
        "database": "mongodb"
      }
    },

    "salesforce": {
      "name": "Salesforce CRM Agent",
      "system_prompt": "Tum ek Salesforce CRM agent ho. Leads manage karo, pipeline dekho, follow-up tasks banao.",
      "tools": ["get_lead", "update_lead", "pipeline_summary", "create_task"],
      "data_source": {
        "type": "salesforce_api",
        "instance_url": "https://your-org.salesforce.com"
      },
      "integrations": {
        "crm": "salesforce",
        "email": "salesforce_email",
        "database": "salesforce_db"
      }
    }

  },

  "llm": {
    "provider": "ollama",
    "model": "llama3",
    "temperature": 0.3,
    "options": {
      "ollama":    { "base_url": "http://localhost:11434" },
      "anthropic": { "model": "claude-sonnet-4-20250514" },
      "openai":    { "model": "gpt-4o" },
      "gemini":    { "model": "gemini-pro" }
    }
  },

  "active_industry": "nonprofit"
}
